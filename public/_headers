# Security headers for static files (the Worker adds the same to pages it renders). Audit IA-058.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), usb=()
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  Strict-Transport-Security: max-age=31536000

# Caching (audit IA-054). Files in /img and /fonts never change: give a new photo or font a NEW file name.
/img/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# 3D cars and their textures: cached 30 days (rename the file if a model changes and it must show right away)
/sedan.glb
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
/suv.glb
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
/truck.glb
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
/tex_*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
# Icons and the email logo: 7 days
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon-32.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/icon-512.png
  Cache-Control: public, max-age=604800
/email-logo.png
  Cache-Control: public, max-age=604800
