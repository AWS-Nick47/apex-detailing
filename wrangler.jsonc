{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apex-detailing",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/index.html", "/api/*", "/b/*", "/ack/*", "/job/*", "/pay/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "apex", "database_id": "649d3c26-3a11-41c1-bf87-2f6b4d047e4d", "migrations_dir": "migrations" }
  ],
  // Before/after job photos (private bucket; the Worker serves them to Nick and, once sent, to the customer's gallery)
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "apex-photos" }],
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "SITE_URL": "https://apexdetailingoc.com",
    "NICK_EMAIL": "contact@apexdetailingoc.com",
    "FROM_EMAIL": "Apex Detailing <bookings@apexdetailingoc.com>",
    "IGNORE_CALENDARS": "Birthdays,Holidays,US Holidays,Siri Suggestions,Scheduled Reminders",
    "JOBS_CALENDAR": "Apex Jobs",
    "BLOCK_CALENDAR": "Apex Blocked",
    "SQUARE_ENV": "production",
    "SQUARE_APP_ID": "sq0idp-l2jdVQfcBFEI27eaYgte8A",
    "SQUARE_LOCATION_ID": "LQES540R4XDR0",
    // Owner dashboard: Cloudflare Access team + app audience tags (comma list; add the real-domain app later)
    "ACCESS_TEAM": "awsomenick47.cloudflareaccess.com",
    "ACCESS_AUD": "4f6fe8ceb216e81aaaddff0ca9cc144b3fcf066ba842c22a007fc27ac528b290,f468bbdf513dfeb7a4952fd29312ad5bbd91c2d039622ce37e5a318818f1cbe6",
    "ADMIN_EMAILS": "awsomenick47@gmail.com,contact@apexdetailingoc.com",
    // Turnstile ("are you human" on booking + sign-in): public site key. Switches on once the TURNSTILE_SECRET secret also exists.
    "TURNSTILE_SITEKEY": "0x4AAAAAAFxKfeWBMUpYjRCQ"
  }
  // Secrets (set in the Cloudflare dashboard, never in this file):
  //   ICLOUD_USER, ICLOUD_APP_PASSWORD, RESEND_API_KEY, SQUARE_ACCESS_TOKEN, TURNSTILE_SECRET
  // Local dev: wrangler.local.jsonc (gitignored) is the same file; run wrangler dev -c wrangler.local.jsonc
}
